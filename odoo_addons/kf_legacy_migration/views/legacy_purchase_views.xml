<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kf_legacy_purchase_document_list" model="ir.ui.view">
        <field name="name">kf.legacy.purchase.document.list</field>
        <field name="model">kf.legacy.purchase.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="review_status == 'review'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="document_date"/>
                <field name="vendor_id"/>
                <field name="source_vendor_number" optional="hide"/>
                <field name="source_status_summary" optional="show"/>
                <field name="currency_summary" optional="show"/>
                <field name="source_line_count"/>
                <field name="cancelled_line_count" optional="show"/>
                <field name="review_status"/>
            </list>
        </field>
    </record>

    <record id="view_kf_legacy_purchase_document_form" model="ir.ui.view">
        <field name="name">kf.legacy.purchase.document.form</field>
        <field name="model">kf.legacy.purchase.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" class="kf_legacy_full_width_form">
                <sheet class="kf_legacy_full_width_sheet">
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="document_date"/>
                            <field name="vendor_id"/>
                            <field name="source_vendor_number"/>
                            <field name="source_collective_number"/>
                        </group>
                        <group>
                            <field name="source_group_key"/>
                            <field name="source_status_summary"/>
                            <field name="currency_summary"/>
                            <field name="source_line_count"/>
                            <field name="cancelled_line_count"/>
                            <field name="review_status"/>
                            <field name="source_system"/>
                        </group>
                    </group>
                    <group invisible="review_status != 'review'">
                        <field name="review_note" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Bestellpositionen">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0" decoration-danger="cancelled">
                                    <field name="position_number"/>
                                    <field name="source_order_number" optional="show"/>
                                    <field name="article_number"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="quantity_ordered" sum="Summe"/>
                                    <field name="quantity_delivered" optional="show" sum="Summe"/>
                                    <field name="quantity_reserved" optional="hide" sum="Summe"/>
                                    <field name="price_raw" optional="show"/>
                                    <field name="price_unit_raw" optional="hide"/>
                                    <field name="currency_symbol" optional="show"/>
                                    <field name="source_uom_key" optional="hide"/>
                                    <field name="document_date" optional="show"/>
                                    <field name="planned_date" optional="hide"/>
                                    <field name="delivery_date" optional="hide"/>
                                    <field name="source_status" optional="show"/>
                                    <field name="cancelled" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kf_legacy_purchase_document_search" model="ir.ui.view">
        <field name="name">kf.legacy.purchase.document.search</field>
        <field name="model">kf.legacy.purchase.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="source_vendor_number"/>
                <field name="line_ids" string="Artikel / Position"/>
                <filter name="purchase" string="Bestellungen" domain="[('document_type','=','purchase')]"/>
                <filter name="framework" string="Rahmenverträge" domain="[('document_type','=','framework')]"/>
                <filter name="review" string="Prüfung erforderlich" domain="[('review_status','=','review')]"/>
                <separator/>
                <filter name="group_vendor" string="Gruppieren nach Lieferant" context="{'group_by':'vendor_id'}"/>
                <filter name="group_type" string="Gruppieren nach Belegart" context="{'group_by':'document_type'}"/>
                <filter name="group_year" string="Gruppieren nach Jahr" context="{'group_by':'document_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_kf_legacy_purchase_document" model="ir.actions.act_window">
        <field name="name">Historische Einkaufsbelege</field>
        <field name="res_model">kf.legacy.purchase.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_kf_legacy_purchase_root" name="Einkaufsbelege (Historie)"
              parent="menu_kf_legacy_trace_root" action="action_kf_legacy_purchase_document"
              sequence="50" groups="base.group_user"/>
</odoo>
