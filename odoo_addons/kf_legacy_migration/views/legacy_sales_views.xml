<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_kf_legacy_history" model="ir.ui.view">
        <field name="name">sale.order.form.kf.legacy.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="alert" invisible="not kf_legacy_history">
                    Historischer eEvolution-Beleg – rein informativ, schreibgeschützt und ohne Lager- oder Buchhaltungswirkung.
                </div>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="kf_legacy_history" invisible="1"/>
                <field name="kf_legacy_source_id" invisible="not kf_legacy_history"/>
                <field name="kf_legacy_identifier" invisible="not kf_legacy_history"/>
                <field name="kf_legacy_original_status" invisible="not kf_legacy_history"/>
            </xpath>
        </field>
    </record>

    <record id="view_kf_legacy_sales_document_list" model="ir.ui.view">
        <field name="name">kf.legacy.sales.document.list</field>
        <field name="model">kf.legacy.sales.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="review_reason in ('address','multiple')">
                <field name="name"/>
                <field name="document_type"/>
                <field name="document_date"/>
                <field name="partner_id"/>
                <field name="review_reason"/>
                <field name="source_line_count"/>
                <field name="valid_line_count"/>
                <field name="source_finished" optional="show"/>
                <field name="source_identifier" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kf_legacy_sales_document_form" model="ir.ui.view">
        <field name="name">kf.legacy.sales.document.form</field>
        <field name="model">kf.legacy.sales.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" class="kf_legacy_full_width_form">
                <sheet class="kf_legacy_full_width_sheet">
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="source_id"/>
                            <field name="source_identifier"/>
                            <field name="document_type"/>
                            <field name="document_date"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="review_reason"/>
                            <field name="source_status"/>
                            <field name="source_finished"/>
                            <field name="source_line_count"/>
                            <field name="valid_line_count"/>
                            <field name="source_system"/>
                        </group>
                    </group>
                    <group>
                        <field name="review_note" nolabel="1"/>
                    </group>
                    <group string="Abweichende Lieferadresse" invisible="review_reason not in ('address','multiple')">
                        <group>
                            <field name="delivery_name"/>
                            <field name="delivery_contact"/>
                            <field name="delivery_street"/>
                        </group>
                        <group>
                            <field name="delivery_zip"/>
                            <field name="delivery_city"/>
                            <field name="delivery_country_code"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quellpositionen">
                            <field name="line_ids" readonly="1">
                                <list create="0" edit="0" delete="0" decoration-muted="not valid">
                                    <field name="position_number"/>
                                    <field name="valid"/>
                                    <field name="article_number"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" optional="show"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="source_tax_key" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kf_legacy_sales_document_search" model="ir.ui.view">
        <field name="name">kf.legacy.sales.document.search</field>
        <field name="model">kf.legacy.sales.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_identifier"/>
                <field name="partner_id"/>
                <filter name="no_lines" string="Positionen prüfen" domain="[('review_reason','in',('no_lines','multiple'))]"/>
                <filter name="address" string="Lieferadresse prüfen" domain="[('review_reason','in',('address','multiple'))]"/>
                <filter name="product" string="Artikel prüfen" domain="[('review_reason','in',('product','multiple'))]"/>
                <separator/>
                <filter name="group_reason" string="Gruppieren nach Prüfgrund" context="{'group_by':'review_reason'}"/>
                <filter name="group_year" string="Gruppieren nach Jahr" context="{'group_by':'document_date:year'}"/>
            </search>
        </field>
    </record>

    <record id="action_kf_legacy_sales_document" model="ir.actions.act_window">
        <field name="name">Verkaufsbelege – Prüfliste</field>
        <field name="res_model">kf.legacy.sales.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kf_legacy_sale_order" model="ir.actions.act_window">
        <field name="name">Historische Verkaufsbelege</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('kf_legacy_history','=',True)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <menuitem id="menu_kf_legacy_sales_root" name="Verkaufsbelege (Historie)"
              parent="menu_kf_legacy_trace_root" sequence="40" groups="base.group_user"/>
    <menuitem id="menu_kf_legacy_sale_orders" name="Übernommene Belege"
              parent="menu_kf_legacy_sales_root" action="action_kf_legacy_sale_order"
              sequence="10" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_kf_legacy_sales_review" name="Prüfliste"
              parent="menu_kf_legacy_sales_root" action="action_kf_legacy_sales_document"
              sequence="20" groups="base.group_user"/>
</odoo>
