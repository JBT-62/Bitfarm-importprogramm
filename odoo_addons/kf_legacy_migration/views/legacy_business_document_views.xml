<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kf_legacy_business_document_list" model="ir.ui.view">
        <field name="name">kf.legacy.business.document.list</field>
        <field name="model">kf.legacy.business.document</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="cancelled" decoration-warning="review_status == 'review'">
                <field name="name"/><field name="document_type"/><field name="document_date"/>
                <field name="partner_id"/><field name="source_partner_name" optional="hide"/>
                <field name="source_order_number" optional="show"/><field name="currency_symbol" optional="show"/>
                <field name="amount_net" optional="show"/><field name="amount_tax" optional="hide"/>
                <field name="amount_gross" optional="show"/><field name="source_line_count"/>
                <field name="cancelled" optional="show"/><field name="locked"/><field name="review_status"/>
            </list>
        </field>
    </record>
    <record id="view_kf_legacy_business_document_form" model="ir.ui.view">
        <field name="name">kf.legacy.business.document.form</field>
        <field name="model">kf.legacy.business.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" class="kf_legacy_full_width_form">
                <sheet class="kf_legacy_full_width_sheet">
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group>
                        <field name="document_type"/><field name="document_date"/><field name="partner_id"/>
                        <field name="source_partner_number"/><field name="source_partner_name"/>
                    </group><group>
                        <field name="source_id"/><field name="source_order_id"/><field name="source_order_number"/>
                        <field name="source_status"/><field name="currency_symbol"/><field name="cancelled"/>
                        <field name="cancellation_date"/><field name="locked"/><field name="review_status"/>
                    </group></group>
                    <group><field name="amount_net"/><field name="amount_tax"/><field name="amount_gross"/><field name="source_line_count"/></group>
                    <group invisible="review_status != 'review'"><field name="review_note" nolabel="1"/></group>
                    <notebook><page string="Belegpositionen"><field name="line_ids" readonly="1">
                        <list create="0" edit="0" delete="0" decoration-muted="cancelled">
                            <field name="position_number"/><field name="article_number"/><field name="product_id" optional="show"/>
                            <field name="name"/><field name="quantity" sum="Summe"/><field name="uom_name" optional="show"/>
                            <field name="price_unit" optional="show"/><field name="amount" optional="show"/>
                            <field name="tax_rate" optional="hide"/><field name="cancelled" optional="show"/>
                        </list>
                    </field></page></notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_kf_legacy_business_document_search" model="ir.ui.view">
        <field name="name">kf.legacy.business.document.search</field><field name="model">kf.legacy.business.document</field>
        <field name="arch" type="xml"><search>
            <field name="name"/><field name="partner_id"/><field name="source_order_number"/><field name="line_ids" string="Artikel / Position"/>
            <filter name="delivery" string="Lieferscheine" domain="[('document_type','=','delivery')]"/>
            <filter name="out" string="Ausgangsrechnungen" domain="[('document_type','in',('out_invoice','out_refund'))]"/>
            <filter name="incoming" string="Eingangsrechnungen" domain="[('document_type','=','in_invoice')]"/>
            <filter name="review" string="Prüfung erforderlich" domain="[('review_status','=','review')]"/>
            <separator/><filter name="group_type" string="Gruppieren nach Belegart" context="{'group_by':'document_type'}"/>
            <filter name="group_partner" string="Gruppieren nach Partner" context="{'group_by':'partner_id'}"/>
            <filter name="group_year" string="Gruppieren nach Jahr" context="{'group_by':'document_date:year'}"/>
        </search></field>
    </record>
    <record id="action_kf_legacy_business_document" model="ir.actions.act_window">
        <field name="name">Historische Hauptbelege</field><field name="res_model">kf.legacy.business.document</field>
        <field name="view_mode">list,form</field><field name="context">{'create': False}</field>
    </record>
    <menuitem id="menu_kf_legacy_business_document" name="Lieferscheine und Rechnungen (Historie)"
              parent="menu_kf_legacy_trace_root" action="action_kf_legacy_business_document"
              sequence="60" groups="base.group_user"/>
</odoo>
